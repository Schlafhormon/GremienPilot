# GremienPilot - Environment Configuration
# Copy this file to .env to customize settings
#
# NOTE: When using pre-built Docker images from ghcr.io, no configuration
# is required! The default settings work out of the box.

# ==================================================
# OPTIONAL: Runtime Image Versions
# ==================================================
# Defaults track the existing moving tags. For a stable release, pin these to a
# published release tag instead, for example:
# FRONTEND_IMAGE=ghcr.io/aihpi/pilotproject-protokollierungsassistenz/frontend:v1.2.3
# BACKEND_IMAGE=ghcr.io/aihpi/pilotproject-protokollierungsassistenz/backend:v1.2.3
# BACKEND_GPU_IMAGE=ghcr.io/aihpi/pilotproject-protokollierungsassistenz/backend:v1.2.3-gpu
# OLLAMA_IMAGE=ollama/ollama:0.12.10
#
# Setup scripts also accept PROTOKOLL_IMAGE_TAG=v1.2.3 and
# PROTOKOLL_PULL_POLICY=missing|always|never.

# ==================================================
# OPTIONAL: Whisper Configuration
# ==================================================
# Model size: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL=large-v2

# Device: cpu, cuda, auto (auto-detect)
WHISPER_DEVICE=cpu

# Batch size for transcription (reduce if running out of memory)
WHISPER_BATCH_SIZE=16

# CPU thread tuning. WHISPER_CPU_THREADS is passed to WhisperX/CTranslate2.
# On CPU-only servers, benchmark 8, 16, 24, and 32 for long recordings.
WHISPER_CPU_THREADS=4
# Optional PyTorch/OpenMP tuning. Leave unset unless benchmarking a CPU server.
# TORCH_NUM_THREADS=16
# TORCH_NUM_INTEROP_THREADS=1
# OMP_NUM_THREADS=16
# MKL_NUM_THREADS=16

# Language code
WHISPER_LANGUAGE=de

# Single backend process: alternate local Ollama and transcription on one GPU.
# Models load on demand; local Ollama must be reachable before transcription.
GPU_MODEL_SWITCHING=false
GPU_MODEL_UNLOAD_TIMEOUT_SECONDS=120

# ==================================================
# OPTIONAL: LLM Configuration
# ==================================================
# Model for summarization (must be available in Ollama)
LLM_MODEL=gemma4:31b-it-q4_K_M

# Reasoning for all LLM tasks: empty omits the API field (legacy behavior),
# none disables thinking; low/medium/high/max request reasoning.
# Supported levels depend on model/server; Gemma uses a native boolean switch.
# Enabling thinking may require larger output budgets and longer timeouts.
LLM_REASONING_EFFORT=

# OpenAI-compatible endpoint. Leave unset for Docker Compose so the backend
# uses the internal Ollama service at http://ollama:11434/v1.
# For local backend development without Docker, use:
# LLM_BASE_URL=http://localhost:11434/v1
# For an explicit external endpoint, set the full OpenAI-compatible /v1 URL.
# LLM_BASE_URL=https://your-llm.example/v1

# Shared inactivity timeout and transport retries for all LLM tasks; 0 retries disables them.
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5

# Chunk long TOP transcripts before summarization
LLM_CHUNK_CHARS=12000

# Fall back to plain text when structured LLM output cannot be parsed

# ==================================================
# OPTIONAL: Speaker Memory and Matching
# ==================================================
# Persistent speaker memory is opt-in from the UI. When disabled by the user,
# local embeddings may be extracted for the current job, but no global profile
# suggestions or profile embeddings are created.
SPEAKER_EMBEDDING_ENABLED=true
SPEAKER_EMBEDDING_MODEL=pyannote/embedding
SPEAKER_EMBEDDING_FALLBACK_MODELS=pyannote/wespeaker-voxceleb-resnet34-LM
SPEAKER_MATCH_AUTO_THRESHOLD=0.82
SPEAKER_MATCH_SUGGEST_THRESHOLD=0.72
SPEAKER_MATCH_TOP_K=3
SPEAKER_EMBEDDING_MIN_SECONDS=8.0
SPEAKER_EMBEDDING_MIN_SEGMENT_SECONDS=1.5
SPEAKER_EMBEDDING_MAX_SEGMENT_SECONDS=12.0
SPEAKER_EMBEDDING_MAX_SEGMENTS=8
SPEAKER_PROFILE_MAX_EMBEDDINGS_PER_MODEL=16
# PyTorch 2.6+ compatibility for WhisperX/pyannote checkpoints.
TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1

# ==================================================
# OPTIONAL: Agenda Detection and Pipeline
# ==================================================
# Agenda LLM server default. Explicit API use_llm / pipeline agenda_use_llm
# overrides it; omitted/null inherits it. Model and prompt never enable it.
# Deprecated compatibility setting; transport now uses LLM_READ_TIMEOUT_SECONDS for all tasks.
# Context and output budgets plan all agenda tasks; CHUNK_LINES=0 adds no fixed row cap.
# Legacy overlap/context-window settings below are ignored by the model-only workflow.
AGENDA_DETECTION_USE_LLM=true
AGENDA_DETECTION_TIMEOUT_SECONDS=8
AGENDA_DETECTION_CHUNK_LINES=0
AGENDA_DETECTION_CHUNK_OVERLAP_LINES=12
AGENDA_DETECTION_CONTEXT_WINDOW_BEFORE=4
AGENDA_DETECTION_CONTEXT_WINDOW_AFTER=8

# Legacy concurrency settings; durable model jobs share one serial queue and resume after restart.
PIPELINE_CONCURRENCY=1
SUMMARY_CONCURRENCY=1

# ==================================================
# OPTIONAL: Persistence and Job Handling
# ==================================================
# Docker Compose mounts ./data to /app/data so sessions survive container
# recreation and setup stop/start cycles.
PERSISTENCE_DB_PATH=/app/state/sessions.sqlite3

# Cleanup controls for in-memory job cache and retained audio uploads.
JOB_MAX_AGE_SECONDS=7200
JOB_MAX_COUNT=100
DELETE_UPLOADS_ON_JOB_CLEANUP=false
DELETE_UPLOADS_ON_CANCEL_OR_FAILURE=true
MAX_UPLOAD_BYTES=524288000
TRANSCRIPTION_CONCURRENCY=1

# ==================================================
# FOR DEVELOPERS ONLY: Building Images Locally
# ==================================================
# HuggingFace token is ONLY needed if you're building Docker images locally
# instead of using the pre-built images from ghcr.io
#
# Get your token at: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_your_token_here
# HUGGINGFACE_TOKEN=hf_your_token_here

# Budgeted Ollama calls and bounded repair (native API sends num_ctx per request).
LLM_OLLAMA_NATIVE=
LLM_CONTEXT_TOKENS=131072
LLM_CPU_THREADS=
LLM_CACHE_DIR=/app/data/llm-cache


# Optional private raw request/response audit; contains meeting data.
LLM_AUDIT_DIR=

# Ollama server memory controls (forwarded by Docker Compose).
# q8_0 reduces KV-cache memory; requires Flash Attention.
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=f16
OLLAMA_KEEP_ALIVE=5m
# The GPU Compose override respects WHISPER_DEVICE. Use cpu to reserve
# VRAM for Ollama, or cuda to run transcription on the GPU too.

# Central model/transport settings; see docs/llm-configuration.md.
# Empty: legacy endpoint detection. Explicit: ollama or openai-compatible.
LLM_PROVIDER=
# Ollama boolean; external servers use LLM_REASONING_EFFORT. Never set both.
LLM_THINKING=
# Extra generation reservation, not a separately enforced thinking limit.
LLM_THINKING_TOKENS=0
# Empty preserves task-specific output budgets; otherwise explicit override.
LLM_OUTPUT_TOKENS=
LLM_OUTPUT_PARAMETER=max_tokens
LLM_TEMPERATURE=
LLM_TOP_P=
LLM_TOP_K=
LLM_SEED=
LLM_GPU_LAYERS=
LLM_KEEP_ALIVE=
LLM_CONNECT_TIMEOUT_SECONDS=10
# Empty inherits LLM_TIMEOUT_SECONDS (inactivity, not total).
LLM_READ_TIMEOUT_SECONDS=
# 0 allows arbitrarily long streams; connect/read limits still apply.
LLM_TOTAL_TIMEOUT_SECONDS=0
# 0 rejects images until a model-appropriate per-image upper bound is configured.
LLM_IMAGE_TOKENS=0
# Optional local Hugging Face tokenizer.json; no download or code execution. Mount in containers.
LLM_TOKENIZER_PATH=
LLM_TOKENIZER_MODEL=
# Immutable external model revision for cache reuse; native Ollama resolves digest.
LLM_MODEL_REVISION=

# Ollama server model-load watchdog (independent of transport inactivity).
OLLAMA_LOAD_TIMEOUT=5m

# Durable model jobs: one backend process/replica per local SQLite database.
MODEL_JOB_LEASE_SECONDS=60
# Total takeover/transport attempts, including interrupted runs; successful steps are retained.
MODEL_JOB_MAX_ATTEMPTS=3
# PDF retention after completed/cancelled; 0 retains indefinitely. Cleanup is explicit, dry-run by default.
MODEL_DOCUMENT_RETENTION_DAYS=0
# Model load / first output; after real output LLM_READ_TIMEOUT_SECONDS bounds silence.
LLM_LOAD_TIMEOUT_SECONDS=1800

# PDF: alle Seiten als Bild + Originaltext; Grenzen verursachen Fehler, keine Kürzung.
# Vision-Modell und dessen LLM_IMAGE_TOKENS explizit konfigurieren (0 verweigert Bilder).
PDF_RENDER_DPI=180
PDF_MAX_PAGE_PIXELS=16000000
PDF_MAX_PAGES=100
PDF_OUTPUT_TOKENS=8192
# Technische Modellreparaturen je Schritt / vollständige Prüfrunden einschließlich Erstprüfung
PDF_MODEL_ATTEMPTS=3
PDF_REVIEW_ROUNDS=3

# Modellgestützte Agenda: Ausgabeplanung und begrenzte technische Reparatur
AGENDA_OUTPUT_TOKENS=4096
# Fast: more output headroom, still one attempt and no independent content review.
AGENDA_FAST_OUTPUT_TOKENS=8192
AGENDA_OUTPUT_TOKENS_PER_LINE=256
# Compact contiguous ranges, expanded and checked for every source line.
# Example: true with PER_LINE=40 and CHUNK_LINES=80; blind review stays enabled.
AGENDA_COMPACT_ASSIGNMENTS=false
AGENDA_MODEL_ATTEMPTS=2
AGENDA_REPAIR_SPLIT_DEPTH=3
AGENDA_SOURCE_REQUEST_ROUNDS=2
# Mandatory complete source review; same model/thinking/provider as generation.
SUMMARY_OUTPUT_TOKENS=4096
SUMMARY_MODEL_ATTEMPTS=2
SUMMARY_RECONCILIATION_ROUNDS=2
